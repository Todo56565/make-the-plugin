{
  "name": "dsh-token-budget",
  "version": "0.4.0",
  "private": true,
  "description": "dsh-agent-teams 的补丁插件：团队会话的上下文预算提示、45% 主动压缩、成员笔记与只读历史工具",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Todo56565/make-the-plugin.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-teams",
    "token-budget"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.1 || 0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@nanmicoder/dsh-agent-teams": "0.1.25 || 0.1.24 || 0.1.23",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.31",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
